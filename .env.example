# Variables de entorno necesarias para ejecutar IngemSistem.
# Copiar a .env y completar con los valores reales. NUNCA subir .env al repo.

# Base de datos (MySQL/TiDB)
DATABASE_URL=

# Autenticación
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# Servicios integrados (Manus Forge)
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=

# Frontend (Vite)
VITE_APP_ID=
VITE_APP_TITLE=
VITE_APP_LOGO=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
